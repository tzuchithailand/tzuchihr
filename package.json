{
  "name": "hospital-interpreter-app",
  "version": "1.0.0",
  "description": "Mobile-first Hospital Interpreter Management Web App with GPS Checkin and Medical Certificate Upload",
  "scripts": {
    "server": "node server/server.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"node server/server.js\" \"npm --prefix client run dev\"",
    "build": "npm --prefix client run build",
    "start": "node server/server.js"
  },
  "dependencies": {
    "concurrently": "^9.1.2"
  }
}
